# Málaga Startup Network — bloquear fuentes y enrutar SPA
RewriteEngine On
# 301 (27-oct-2026, encargo de Isaac): el subdominio de Rock&Change se retira; todo va al dominio oficial.
# Solo actua si la peticion llega al subdominio (no afecta a malagastartupnetwork.com aunque se suba alli).
RewriteCond %{HTTP_HOST} ^malaga-startup-network\.rockandchange\.es$ [NC]
RewriteRule ^(?:startups/)?(.*)$ https://malagastartupnetwork.com/startups/$1 [R=301,L]
# Bloqueo de bots de scraping / entrenamiento de IA
RewriteCond %{HTTP_USER_AGENT} (GPTBot|CCBot|ClaudeBot|Claude-Web|anthropic-ai|Google-Extended|Bytespider|Amazonbot|meta-externalagent|FacebookBot|Applebot-Extended|cohere-ai|Diffbot|ImagesiftBot|Timpibot|omgili|PetalBot|DataForSeoBot|AhrefsBot|SemrushBot|MJ12bot|DotBot|BLEXBot|Scrapy|HTTrack|SiteSnagger|WebCopier|Offline.Explorer) [NC]
RewriteRule .* - [F,L]
RewriteRule ^project/ - [F,L]
RewriteRule ^(src|supabase|node_modules)/ - [F,L]
<IfModule mod_rewrite.c>
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
